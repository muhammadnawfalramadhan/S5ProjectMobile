<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/siksp_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/siksp_bg"
        app:navigationIconTint="@color/siksp_teks"
        app:titleTextAppearance="@style/ToolbarTitle"
        app:titleTextColor="@color/siksp_teks" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Avatar (ganti src dengan foto sendiri, misal @drawable/foto_profil) -->
            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_avatar"
                android:contentDescription="@string/profil_nama"
                android:padding="18dp"
                android:src="@drawable/logo_siksp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/jakarta_bold"
                android:gravity="center"
                android:text="@string/profil_nama"
                android:textColor="@color/siksp_teks"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jakarta_bold"
                android:text="@string/profil_nim"
                android:textColor="@color/siksp_hijau_muda"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/jakarta_regular"
                android:gravity="center"
                android:text="@string/profil_prodi"
                android:textColor="@color/siksp_teks_abu"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_bold"
                    android:letterSpacing="0.1"
                    android:text="@string/profil_label_sosmed"
                    android:textAllCaps="true"
                    android:textColor="@color/siksp_hijau_muda"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_bold"
                        android:text="@string/profil_github_label"
                        android:textColor="@color/siksp_teks_abu"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/jakarta_regular"
                        android:text="@string/profil_github"
                        android:textColor="@color/siksp_biru_muda"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_bold"
                        android:text="@string/profil_instagram_label"
                        android:textColor="@color/siksp_teks_abu"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/jakarta_regular"
                        android:text="@string/profil_instagram"
                        android:textColor="@color/siksp_biru_muda"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jakarta_bold"
                        android:text="@string/profil_email_label"
                        android:textColor="@color/siksp_teks_abu"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/jakarta_regular"
                        android:text="@string/profil_email"
                        android:textColor="@color/siksp_biru_muda"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_bold"
                    android:letterSpacing="0.1"
                    android:text="@string/profil_label_hobi"
                    android:textAllCaps="true"
                    android:textColor="@color/siksp_hijau_muda"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/jakarta_regular"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/profil_hobi"
                    android:textColor="@color/siksp_teks"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_bold"
                    android:letterSpacing="0.1"
                    android:text="@string/profil_label_kekuatan"
                    android:textAllCaps="true"
                    android:textColor="@color/siksp_hijau_muda"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/jakarta_regular"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/profil_kekuatan"
                    android:textColor="@color/siksp_teks"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jakarta_bold"
                    android:letterSpacing="0.1"
                    android:text="@string/profil_label_skill"
                    android:textAllCaps="true"
                    android:textColor="@color/siksp_hijau_muda"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/jakarta_regular"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/profil_skill"
                    android:textColor="@color/siksp_teks"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
